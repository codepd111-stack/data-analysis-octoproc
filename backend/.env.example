# --- database ---
DATABASE_URL=

# --- AI ---
GROQ_API_KEY=
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
INCLUDE_SAMPLE_VALUES=true
# Columns per table shown to the AI when drafting the semantic layer
SEMANTIC_MAX_COLUMNS=80

# --- file storage: local (development) or s3 (production) ---
# "local" keeps files on this machine's disk. On a host with an ephemeral disk (Render, Fly, ...)
# they vanish on every deploy, so production MUST use s3 (Supabase Storage, Cloudflare R2, B2, AWS).
STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Where S3 objects are cached locally for DuckDB; empty = the system temp directory
S3_CACHE_DIR=

# --- limits ---
MAX_UPLOAD_MB=50
MAX_QUERY_ROWS=200
DUCKDB_MEMORY_LIMIT=1GB

# --- web ---
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# true ONLY when a reverse proxy (Render, nginx, ...) sits in front of the API and sets
# X-Forwarded-For. Otherwise the header is client-supplied and must not be trusted.
TRUST_PROXY_HEADERS=false

# --- sign-in (leave ACCESS_CODE empty for local development) ---
ACCESS_CODE=
# At least 16 random characters, required when ACCESS_CODE is set
AUTH_SECRET=
AUTH_TOKEN_DAYS=7
